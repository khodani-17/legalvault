generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/**
 * |--------------------------------------------------------------------------
 * | FIRM
 * |--------------------------------------------------------------------------
 */

model Firm {
  id                 String   @id @default(cuid())
  referenceNumber    String   @unique
  name               String
  registrationNumber String?
  email              String?
  phone              String?
  address            String?
  logoUrl            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  auditLogs        AuditLog[]
  clients          Client[]
  conflictChecks   ConflictCheck[]
  deadlines        Deadline[]
  documents        Document[]
  financeDocuments FinanceDocument[]
  financeFolders   FinanceFolder[]
  folders          Folder[]
  matters          Matter[]
  accessRequests   MatterAccessRequest[]
  intakes          MatterIntake[]
  notifications    Notification[]
  payments         Payment[]
  subscription     Subscription?
  tasks            Task[]
  users            User[]

  correspondences           Correspondence[]
  correspondenceAttachments CorrespondenceAttachment[]

  @@index([name])
}

/**
 * |--------------------------------------------------------------------------
 * | SUBSCRIPTION
 * |--------------------------------------------------------------------------
 */

model Subscription {
  id                     String             @id @default(cuid())
  firmId                 String             @unique
  plan                   SubscriptionPlan   @default(TRIAL)
  status                 SubscriptionStatus @default(PENDING_PAYMENT)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  trialEndsAt            DateTime?
  cancelledAt            DateTime?
  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  cancelAtPeriodEnd      Boolean            @default(false)

  payments Payment[]
  firm     Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([providerCustomerId])
  @@index([providerSubscriptionId])
}

/**
 * |--------------------------------------------------------------------------
 * | PAYMENT
 * |--------------------------------------------------------------------------
 */

model Payment {
  id                    String        @id @default(cuid())
  firmId                String
  subscriptionId        String
  amount                Decimal       @db.Decimal(12, 2)
  currency              String        @default("ZAR")
  status                PaymentStatus @default(PENDING)
  paymentReference      String        @unique
  receiptNumber         String        @unique
  provider              String        @default("PAYFAST")
  providerTransactionId String?
  providerPaymentId     String?       @unique
  paymentMethod         String?
  paidAt                DateTime?
  receiptEmail          String?
  receiptSentAt         DateTime?
  receiptSendError      String?
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  firm         Firm         @relation(fields: [firmId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([subscriptionId])
  @@index([status])
  @@index([provider])
  @@index([providerTransactionId])
  @@index([paidAt])
  @@index([firmId, createdAt])
}

/**
 * |--------------------------------------------------------------------------
 * | USER
 * |--------------------------------------------------------------------------
 */

model User {
  id           String     @id @default(cuid())
  firmId       String
  name         String
  email        String     @unique
  passwordHash String?
  role         UserRole   @default(LEGAL_SECRETARY)
  status       UserStatus @default(ACTIVE)
  avatarUrl    String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  auditLogs AuditLog[]

  assignedDeadlines  Deadline[] @relation("AssignedDeadlines")
  completedDeadlines Deadline[] @relation("CompletedDeadlines")
  createdDeadlines   Deadline[] @relation("CreatedDeadlines")

  uploadedDocuments        Document[]        @relation("UploadedDocuments")
  uploadedFinanceDocuments FinanceDocument[] @relation("UploadedFinanceDocuments")

  matterAccessRequests   MatterAccessRequest[] @relation("MatterAccessRequester")
  reviewedAccessRequests MatterAccessRequest[] @relation("MatterAccessReviewer")

  assignedMatterIntakes  MatterIntake[] @relation("AssignedMatterIntakes")
  conflictCheckedIntakes MatterIntake[] @relation("ConflictCheckedMatterIntakes")
  createdMatterIntakes   MatterIntake[] @relation("CreatedMatterIntakes")

  checkedConflictChecks  ConflictCheck[] @relation("ConflictCheckCheckedBy")
  reviewedConflictChecks ConflictCheck[] @relation("ConflictCheckReviewedBy")

  matters             MatterUser[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]

  assignedTasks            Task[] @relation("AssignedTasks")
  createdTasks             Task[] @relation("CreatedTasks")
  delegatedTasks           Task[] @relation("DelegatedTasks")
  delegatedOnBehalfOfTasks Task[] @relation("DelegatedOnBehalfOfTasks")

  taskNotes              TaskNote[]              @relation("TaskNotes")
  submittedTaskReports   TaskReport[]            @relation("SubmittedTaskReports")
  reviewedTaskReports    TaskReport[]            @relation("ReviewedTaskReports")
  taskAssistanceRequests TaskAssistanceRequest[] @relation("TaskAssistanceRequests")
  taskActivities         TaskActivity[]          @relation("TaskActivities")

  createdCorrespondences     Correspondence[]           @relation("CreatedCorrespondences")
  responsibleCorrespondences Correspondence[]           @relation("ResponsibleCorrespondences")
  correspondenceAttachments  CorrespondenceAttachment[] @relation("CorrespondenceAttachments")

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([firmId, role])
}

/**
 * |--------------------------------------------------------------------------
 * | PASSWORD RESET
 * |--------------------------------------------------------------------------
 */

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/**
 * |--------------------------------------------------------------------------
 * | CLIENT
 * |--------------------------------------------------------------------------
 */

model Client {
  id              String     @id @default(cuid())
  firmId          String
  referenceNumber String
  type            ClientType @default(INDIVIDUAL)
  name            String
  email           String?
  phone           String?
  idNumber        String?
  address         String?
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  firm           Firm            @relation(fields: [firmId], references: [id], onDelete: Cascade)
  conflictChecks ConflictCheck[]
  matters        Matter[]
  intakes        MatterIntake[]

  correspondences Correspondence[]

  @@unique([firmId, referenceNumber])
  @@index([firmId])
  @@index([firmId, name])
}

/**
 * |--------------------------------------------------------------------------
 * | MATTER
 * |--------------------------------------------------------------------------
 */

model Matter {
  id              String       @id @default(cuid())
  firmId          String
  clientId        String
  referenceNumber String
  title           String
  description     String?
  practiceArea    String?
  status          MatterStatus @default(OPEN)
  openedAt        DateTime     @default(now())
  closedAt        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  intakeId String? @unique

  deadlines      Deadline[]
  documents      Document[]
  folders        Folder[]
  accessRequests MatterAccessRequest[]
  users          MatterUser[]
  tasks          Task[]

  correspondences Correspondence[]

  client Client @relation(fields: [clientId], references: [id])
  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)

  convertedMatter MatterIntake? @relation("ConvertedMatter", fields: [intakeId], references: [id])

  @@unique([firmId, referenceNumber])
  @@index([clientId])
  @@index([firmId])
  @@index([firmId, status])
}

/**
 * |--------------------------------------------------------------------------
 * | MATTER USER ACCESS
 * |--------------------------------------------------------------------------
 */

model MatterUser {
  id          String   @id @default(cuid())
  matterId    String
  userId      String
  canView     Boolean  @default(true)
  canUpload   Boolean  @default(false)
  canDownload Boolean  @default(false)
  canDelete   Boolean  @default(false)
  canManage   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  matter Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matterId, userId])
  @@index([userId])
}

/**
 * |--------------------------------------------------------------------------
 * | MATTER ACCESS REQUEST
 * |--------------------------------------------------------------------------
 */

model MatterAccessRequest {
  id              String              @id @default(cuid())
  firmId          String
  matterId        String
  requesterId     String
  reviewedById    String?
  reason          String
  status          AccessRequestStatus @default(PENDING)
  reviewerComment String?
  reviewedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  firm       Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matter     Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  requester  User   @relation("MatterAccessRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewedBy User?  @relation("MatterAccessReviewer", fields: [reviewedById], references: [id])

  @@unique([matterId, requesterId], map: "MatterAccessRequest_pending_unique", where: raw("(status = 'PENDING'::\"AccessRequestStatus\")"))
  @@index([firmId])
  @@index([matterId])
  @@index([requesterId])
  @@index([reviewedById])
  @@index([firmId, status])
}

/**
 * |--------------------------------------------------------------------------
 * | FOLDER
 * |--------------------------------------------------------------------------
 */

model Folder {
  id             String   @id @default(cuid())
  firmId         String
  matterId       String
  parentFolderId String?
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  documents Document[]

  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matter Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)

  parentFolder Folder?  @relation("FolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)
  childFolders Folder[] @relation("FolderHierarchy")

  @@index([firmId])
  @@index([matterId])
  @@index([parentFolderId])
}

/**
 * |--------------------------------------------------------------------------
 * | DOCUMENT
 * |--------------------------------------------------------------------------
 */

model Document {
  id              String         @id @default(cuid())
  firmId          String
  matterId        String
  folderId        String?
  referenceNumber String
  name            String
  originalName    String
  mimeType        String
  extension       String
  size            BigInt
  storageKey      String         @unique
  status          DocumentStatus @default(ACTIVE)
  currentVersion  Int            @default(1)
  category        String?
  tags            String[]       @default([])
  uploadedById    String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  firm       Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  folder     Folder?           @relation(fields: [folderId], references: [id])
  matter     Matter            @relation(fields: [matterId], references: [id], onDelete: Cascade)
  uploadedBy User              @relation("UploadedDocuments", fields: [uploadedById], references: [id])
  versions   DocumentVersion[]

  correspondenceAttachments CorrespondenceAttachment[]

  @@unique([firmId, referenceNumber])
  @@index([firmId])
  @@index([folderId])
  @@index([matterId])
  @@index([status])
}

/**
 * |--------------------------------------------------------------------------
 * | DOCUMENT VERSION
 * |--------------------------------------------------------------------------
 */

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  version      Int
  storageKey   String
  size         BigInt
  uploadedById String
  changeNote   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  extension    String
  mimeType     String
  originalName String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId])
}

/**
 * |--------------------------------------------------------------------------
 * | FINANCE FOLDER
 * |--------------------------------------------------------------------------
 */

model FinanceFolder {
  id             String   @id @default(cuid())
  firmId         String
  parentFolderId String?
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  documents FinanceDocument[]

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  parentFolder FinanceFolder? @relation("FinanceFolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)

  childFolders FinanceFolder[] @relation("FinanceFolderHierarchy")

  @@unique([firmId, parentFolderId, name], map: "FinanceFolder_parent_name_unique", where: raw("(\"parentFolderId\" IS NOT NULL)"))
  @@unique([firmId, name], map: "FinanceFolder_root_name_unique", where: raw("(\"parentFolderId\" IS NULL)"))
  @@index([firmId])
  @@index([parentFolderId])
  @@index([firmId, name])
}

/**
 * |--------------------------------------------------------------------------
 * | FINANCE DOCUMENT
 * |--------------------------------------------------------------------------
 */

model FinanceDocument {
  id           String    @id @default(cuid())
  firmId       String
  name         String
  originalName String
  mimeType     String
  extension    String
  size         BigInt
  storageKey   String    @unique
  uploadedById String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  folderId     String?

  firm       Firm           @relation(fields: [firmId], references: [id], onDelete: Cascade)
  folder     FinanceFolder? @relation(fields: [folderId], references: [id])
  uploadedBy User           @relation("UploadedFinanceDocuments", fields: [uploadedById], references: [id])

  @@index([firmId])
  @@index([folderId])
  @@index([uploadedById])
  @@index([firmId, createdAt])
}

/**
 * |--------------------------------------------------------------------------
 * | TASK MANAGEMENT
 * |--------------------------------------------------------------------------
 */

model Task {
  id       String  @id @default(cuid())
  firmId   String
  matterId String?

  title       String
  description String?

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)

  assignedToId String?
  createdById  String

  delegatedById         String?
  delegatedOnBehalfOfId String?

  dueDate     DateTime?
  completedAt DateTime?

  requiresReport    Boolean            @default(false)
  reportSubmittedAt DateTime?
  reportReviewedAt  DateTime?
  reportOutcome     TaskReportOutcome?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedTo User? @relation("AssignedTasks", fields: [assignedToId], references: [id])

  createdBy User @relation("CreatedTasks", fields: [createdById], references: [id])

  delegatedBy User? @relation("DelegatedTasks", fields: [delegatedById], references: [id], onDelete: SetNull)

  delegatedOnBehalfOf User? @relation("DelegatedOnBehalfOfTasks", fields: [delegatedOnBehalfOfId], references: [id], onDelete: SetNull)

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  matter Matter? @relation(fields: [matterId], references: [id], onDelete: Cascade)

  notes              TaskNote[]
  reports            TaskReport[]
  assistanceRequests TaskAssistanceRequest[]
  activities         TaskActivity[]

  @@index([assignedToId])
  @@index([createdById])
  @@index([delegatedById])
  @@index([delegatedOnBehalfOfId])
  @@index([firmId])
  @@index([matterId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([firmId, status])
  @@index([firmId, dueDate])
}

/**
 * |--------------------------------------------------------------------------
 * | TASK NOTES / UPDATES
 * |--------------------------------------------------------------------------
 */

model TaskNote {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation("TaskNotes", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([authorId])
  @@index([createdAt])
}

/**
 * |--------------------------------------------------------------------------
 * | TASK REPORTS
 * |--------------------------------------------------------------------------
 */

model TaskReport {
  id            String @id @default(cuid())
  taskId        String
  submittedById String

  outcome    TaskReportOutcome
  report     String
  nextAction String?

  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  reviewNote   String?

  task        Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submittedBy User  @relation("SubmittedTaskReports", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy  User? @relation("ReviewedTaskReports", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([submittedById])
  @@index([reviewedById])
  @@index([submittedAt])
}

/**
 * |--------------------------------------------------------------------------
 * | TASK ASSISTANCE REQUESTS
 * |--------------------------------------------------------------------------
 */

model TaskAssistanceRequest {
  id            String @id @default(cuid())
  taskId        String
  requestedById String

  reason   String
  response String?

  status      AssistanceStatus @default(PENDING)
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task        Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy User @relation("TaskAssistanceRequests", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([requestedById])
  @@index([status])
  @@index([createdAt])
}

/**
 * |--------------------------------------------------------------------------
 * | TASK HISTORY / ACTIVITY
 * |--------------------------------------------------------------------------
 */

model TaskActivity {
  id     String @id @default(cuid())
  taskId String
  userId String

  action      String
  description String?
  metadata    Json?

  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("TaskActivities", fields: [userId], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([userId])
  @@index([createdAt])
}

/**
 * |--------------------------------------------------------------------------
 * | DEADLINES
 * |--------------------------------------------------------------------------
 */

model Deadline {
  id       String @id @default(cuid())
  firmId   String
  matterId String

  title       String
  description String?

  type     DeadlineType
  priority DeadlinePriority @default(MEDIUM)
  status   DeadlineStatus   @default(PENDING)

  dueDate DateTime

  assignedToId String?
  createdById  String

  isCalculated    Boolean   @default(false)
  sourceDate      DateTime?
  calculationNote String?

  completedAt   DateTime?
  completedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedTo User? @relation("AssignedDeadlines", fields: [assignedToId], references: [id])

  completedBy User? @relation("CompletedDeadlines", fields: [completedById], references: [id])

  createdBy User @relation("CreatedDeadlines", fields: [createdById], references: [id])

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  matter Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([matterId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([dueDate])
  @@index([firmId, dueDate])
  @@index([firmId, status])
  @@index([matterId, dueDate])
}

/**
 * |--------------------------------------------------------------------------
 * | NOTIFICATIONS
 * |--------------------------------------------------------------------------
 */

model Notification {
  id        String           @id @default(cuid())
  firmId    String
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([userId, isRead])
}

/**
 * |--------------------------------------------------------------------------
 * | AUDIT LOG
 * |--------------------------------------------------------------------------
 */

model AuditLog {
  id          String      @id @default(cuid())
  firmId      String
  userId      String
  action      AuditAction
  entityType  String
  entityId    String?
  description String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([firmId, createdAt])
  @@index([firmId])
  @@index([userId])
}

/**
 * |--------------------------------------------------------------------------
 * | CORRESPONDENCE
 * |--------------------------------------------------------------------------
 */

model Correspondence {
  id       String  @id @default(cuid())
  firmId   String
  matterId String?
  clientId String?

  direction          CorrespondenceDirection
  correspondenceDate DateTime                @default(now())

  sender    String
  recipient String
  subject   String

  type   CorrespondenceType
  status CorrespondenceStatus @default(RECEIVED)

  responsibleUserId String?

  responseRequired Boolean   @default(false)
  responseDeadline DateTime?

  notes String?

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm            Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matter          Matter? @relation(fields: [matterId], references: [id], onDelete: SetNull)
  client          Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy       User    @relation("CreatedCorrespondences", fields: [createdById], references: [id], onDelete: Restrict)
  responsibleUser User?   @relation("ResponsibleCorrespondences", fields: [responsibleUserId], references: [id], onDelete: SetNull)

  attachments CorrespondenceAttachment[]

  @@index([firmId])
  @@index([matterId])
  @@index([clientId])
  @@index([responsibleUserId])
  @@index([createdById])
  @@index([status])
  @@index([direction])
  @@index([type])
  @@index([correspondenceDate])
  @@index([responseDeadline])
  @@index([firmId, status])
  @@index([firmId, responseDeadline])
}

/**
 * |--------------------------------------------------------------------------
 * | CORRESPONDENCE ATTACHMENT
 * |--------------------------------------------------------------------------
 */

model CorrespondenceAttachment {
  id               String @id @default(cuid())
  firmId           String
  correspondenceId String
  documentId       String
  addedById        String

  createdAt DateTime @default(now())

  firm           Firm           @relation(fields: [firmId], references: [id], onDelete: Cascade)
  correspondence Correspondence @relation(fields: [correspondenceId], references: [id], onDelete: Cascade)
  document       Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  addedBy        User           @relation("CorrespondenceAttachments", fields: [addedById], references: [id], onDelete: Restrict)

  @@unique([correspondenceId, documentId])
  @@index([firmId])
  @@index([correspondenceId])
  @@index([documentId])
  @@index([addedById])
}

/**
 * |--------------------------------------------------------------------------
 * | CONFLICT CHECK
 * |--------------------------------------------------------------------------
 */

model ConflictCheck {
  id           String  @id @default(cuid())
  firmId       String
  intakeId     String?
  clientId     String?
  checkedById  String
  reviewedById String?

  status ConflictCheckStatus @default(NOT_CHECKED)

  searchTerms      String[] @default([])
  matchedMatterIds String[] @default([])
  matchedClientIds String[] @default([])

  notes      String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkedBy  User          @relation("ConflictCheckCheckedBy", fields: [checkedById], references: [id])
  reviewedBy User?         @relation("ConflictCheckReviewedBy", fields: [reviewedById], references: [id])
  client     Client?       @relation(fields: [clientId], references: [id])
  intake     MatterIntake? @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  firm       Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([checkedById])
  @@index([clientId])
  @@index([createdAt])
  @@index([firmId])
  @@index([firmId, status])
  @@index([intakeId])
  @@index([reviewedById])
}

/**
 * |--------------------------------------------------------------------------
 * | MATTER INTAKE
 * |--------------------------------------------------------------------------
 */

model MatterIntake {
  id     String @id @default(cuid())
  firmId String

  prospectiveClientName String
  clientId              String?

  email        String?
  phone        String?
  practiceArea String?
  description  String?

  opposingParties String[] @default([])
  relatedParties  String[] @default([])

  source String?

  priority              IntakePriority      @default(MEDIUM)
  conflictCheckRequired Boolean             @default(true)
  conflictStatus        ConflictCheckStatus @default(NOT_CHECKED)
  status                IntakeStatus        @default(NEW)

  assignedToId        String?
  createdById         String
  conflictCheckedAt   DateTime?
  conflictCheckedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conflictChecks  ConflictCheck[]
  convertedMatter Matter?         @relation("ConvertedMatter")

  assignedTo        User?   @relation("AssignedMatterIntakes", fields: [assignedToId], references: [id])
  client            Client? @relation(fields: [clientId], references: [id])
  conflictCheckedBy User?   @relation("ConflictCheckedMatterIntakes", fields: [conflictCheckedById], references: [id])
  createdBy         User    @relation("CreatedMatterIntakes", fields: [createdById], references: [id])
  firm              Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([assignedToId])
  @@index([clientId])
  @@index([createdAt])
  @@index([firmId, conflictStatus])
  @@index([firmId])
  @@index([firmId, priority])
  @@index([firmId, status])
}

/**
 * |--------------------------------------------------------------------------
 * | ENUMS
